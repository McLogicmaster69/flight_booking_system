{% extends "_layout/base.peb" %}

{% set activePage = 'manage' %}

{% block content %}

<div class="wf-center">
  <div class="wf-box">
    <h2 class="wf-title">Manage Bookings</h2>
    <div class="wf-rule"></div>

    <div class="wf-box-dashed">
      <h3 class="wf-subtitle" style="margin-top: 0;">Find a Booking (Guest)</h3>
      <div class="wf-rule"></div>
      <p class="muted" style="color: var(--wf-muted);">If you aren't logged in, enter your details below:</p>

      <form class="wf-inline" method="get" action="/manage" aria-label="Find a booking">
        <div><input type="text" name="ref" placeholder="Ref Number Input" aria-label="Reference number"></div>
        <div><input type="text" name="last" placeholder="Last Name Input" aria-label="Last name"></div>
        <div style="flex:0 0 auto;"><button class="wf-btn" type="submit">FIND BOOKING</button></div>
      </form>
    </div>

    <h3 class="wf-subtitle">Your Current Bookings</h3>
    <div class="wf-rule"></div>

    <div class="wf-box">
      <div style="display:flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
        <div><strong>Flight to Paris (CDG) — Ref: #FB8492X</strong></div>
      </div>
      <div class="wf-rule" style="margin: 10px 0;"></div>
      <div style="color: var(--wf-muted);">Date: Oct 12, 2026 | <strong style="color:#111;">Passengers:</strong> 1</div>
      <div class="wf-rule" style="margin: 10px 0;"></div>

      <div class="wf-actions" style="display:flex; gap: 18px; flex-wrap: wrap;">
        <a href="#">[Change Dates]</a>
        <a href="#">[Modify Passengers]</a>
        <a href="#">[Select Seats]</a>
        <a href="#">[Cancel Booking]</a>
      </div>
    </div>
  </div>
</div>

{% endblock %}
