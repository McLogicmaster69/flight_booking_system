{% extends "_layout/base.peb" %}

{% set layout = 'admin' %}
{% set activePage = 'admin' %}

{% block content %}

<div class="wf-box-dashed">
  <div style="display:flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap;">
    <h2 class="wf-title" style="margin: 0;">System Overview</h2>
    <button class="wf-btn" type="button">GENERATE ADMINISTRATOR REPORT</button>
  </div>

  <div style="margin-top: 18px;"></div>

  <div class="wf-row">
    <div class="wf-col">
      <div class="wf-card" style="padding: 22px;">
        <div>Peak Booking Time</div>
        <div class="wf-rule"></div>
        <div style="font-size: 20px; font-weight: 700;">Tuesdays, 6:00 PM</div>
      </div>
    </div>
    <div class="wf-col">
      <div class="wf-card" style="padding: 22px;">
        <div>Most Popular Route</div>
        <div class="wf-rule"></div>
        <div style="font-size: 22px; font-weight: 700;">JFK → LHR</div>
      </div>
    </div>
    <div class="wf-col">
      <div class="wf-card" style="padding: 22px;">
        <div>Total Active Bookings</div>
        <div class="wf-rule"></div>
        <div style="font-size: 22px; font-weight: 700;">1,284</div>
      </div>
    </div>
  </div>

  <h3 class="wf-subtitle">Flight Availabilities &amp; Tracking</h3>
  <div class="wf-rule"></div>

  <table class="wf-table" aria-label="Flight availabilities">
    <thead>
      <tr>
        <th>Flight ID</th>
        <th>Route</th>
        <th>Date</th>
        <th>Capacity</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>FB-101</td>
        <td>New York (JFK) to London (LHR)</td>
        <td>Oct 12, 2026</td>
        <td>280 / 300 (93%)</td>
        <td><strong>On Time</strong></td>
        <td class="wf-actions"><a href="#">Edit</a> | <a href="#">Cancel Flight</a></td>
      </tr>
      <tr>
        <td>FB-402</td>
        <td>Tokyo (HND) to Paris (CDG)</td>
        <td>Oct 14, 2026</td>
        <td>150 / 300 (50%)</td>
        <td><strong>Delayed</strong></td>
        <td class="wf-actions"><a href="#">Edit</a> | <a href="#">Cancel Flight</a></td>
      </tr>
    </tbody>
  </table>

  <h3 class="wf-subtitle" style="margin-top: 26px;">Recent System Reservations</h3>
  <div class="wf-rule"></div>

  <table class="wf-table" aria-label="Recent reservations">
    <thead>
      <tr>
        <th>Ref Number</th>
        <th>Passenger Last Name</th>
        <th>Flight ID</th>
        <th>Modifications/Cancellations</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>#FB8492X</td>
        <td>Smith</td>
        <td>FB-101</td>
        <td style="color: var(--wf-muted);">None</td>
      </tr>
      <tr>
        <td>#FB1129Y</td>
        <td>Doe</td>
        <td>FB-402</td>
        <td style="color: var(--wf-muted);">Seat Changed (12A to 14C)</td>
      </tr>
    </tbody>
  </table>
</div>

{% endblock %}
