{% extends "_layout/base.peb" %}

{% set activePage = 'book' %}

{% block content %}

<!-- Filters column -->
<aside style="flex: 0 0 320px;">
  <div>
    <h2>Filters</h2>

    <label for="tripType">Trip Type</label>
    <select class="general-input" id="tripType" name="tripType">
      <option>Round Trip</option>
      <option>One Way</option>
      <option>Multi-city</option>
    </select>

    <label for="maxLayovers">Max Layovers</label>
    <select class="general-input" id="maxLayovers" name="maxLayovers">
      <option>Any</option>
      <option>Direct Only</option>
      <option>1</option>
      <option>2+</option>
    </select>

    <label for="maxDuration">Max Duration (Hours)</label>
    <input class="general-input" id="maxDuration" name="maxDuration" type="text" placeholder="e.g. 15">

    <label for="priceRange">Price Range</label>
    <input class="general-input" id="priceRange" name="priceRange" type="range" min="0" max="100" value="40" aria-label="Price Range">

    <label for="sortBy">Sort By</label>
    <select class="general-input" id="sortBy" name="sortBy">
      <option>Fastest to Slowest</option>
      <option>Cheapest to Most Expensive</option>
    </select>
  </div>
</aside>

<!-- Results column -->
<section>
  <div>
    <h2>Find Your Flight</h2>

    <form method="get" action="/book" aria-label="Find Your Flight">
      <div><input class="general-input" name="from" type="text" placeholder="Origin"></div>
      <div><input class="general-input" name="to" type="text" placeholder="Destination"></div>
      <div><input class="general-input" name="depart" type="text" placeholder="dd/mm/yyyy"></div>
      <div style="flex:0 0 auto;"><button type="submit">SEARCH</button></div>
    </form>

    <h3>Available Flights</h3>
  </div>
</section>
{% endblock %}
