{% extends "_layout/base.peb" %}

{% set activePage = 'book' %}
{% set inNav = true %}

{% block content %}

<div style="margin-bottom: 24px;">
  <h2 class="page-title" style="margin-bottom: 8px;">Book a Flight</h2>
  <p class="page-subtitle">Search for available routes, choose dates, and filter your preferences.</p>
</div>

<form id="homepageSearchForm" hx-post="/book-search" hx-target="#flight-results" hx-swap="innerHTML" hx-trigger="submit" style="display: flex; gap: 24px; flex-wrap: wrap; align-items: flex-start;">

  <aside style="flex: 1 1 250px; min-width: 250px;">
    <div class="card">
      <h3>Filters</h3>

      <label for="tripType">Trip Type</label>
      <select class="general-input" id="tripType" name="tripType">
        <option value="roundTrip">Round Trip</option>
        <option value="oneWay">One Way</option>
      </select>

      <label for="maxLayovers">Max Layovers</label>
      <select class="general-input" id="maxLayovers" name="maxLayovers">
        <option>Direct Only</option>
        <option>1</option>
        <option>2</option>
        <option>Any</option>
      </select>

      <label for="maxDuration">Max Duration (Hours)</label>
      <input class="general-input" id="maxDuration" name="maxDuration" type="number" placeholder="e.g. 15">

      <label for="priceRange">Max Price</label>
      <input class="general-input" id="priceRange" name="priceRange" type="range" min="0" max="100" value="100">
      <small class="muted" style="display: block; margin-bottom: 12px;">0 = £0, 100 = no limit</small>

      <label for="sortBy">Sort By</label>
      <select class="general-input" id="sortBy" name="sortBy" style="margin-bottom: 0;">
        <option>Fastest to Slowest</option>
        <option>Cheapest to Most Expensive</option>
      </select>
    </div>
  </aside>

  <section style="flex: 3 1 500px; min-width: 300px;">
    <div class="card">
      <h3>Search Details</h3>

      <div class="grid">
        <div class="col-6">
          <label for="from">From</label>
          <input class="general-input" id="from" name="from" type="text" list="destinationsList"
            value="{{ fromValue | default('') }}" placeholder="From (Origin)" aria-label="From (Origin)"
            aria-describedby="fromError" required>
          <small id="fromError" class="error" aria-live="polite"></small>
        </div>

        <div class="col-6">
          <label for="to">To</label>
          <input class="general-input" id="to" name="to" type="text" list="destinationsList"
            value="{{ toValue | default('') }}" placeholder="To (Destination)" aria-label="To (Destination)"
            aria-describedby="toError" required>
          <small id="toError" class="error" aria-live="polite"></small>
        </div>

        <div class="col-6">
          <label for="depart">Departure date</label>
          <input class="general-input" id="depart" name="depart" type="date" value="{{ departValue | default('') }}"
            aria-label="Depart date" aria-describedby="departError" required>
          <small id="departError" class="error" aria-live="polite"></small>
        </div>

        <div class="col-6" id="returnDateField">
          <label for="returnDate">Return date</label>
          <input class="general-input"
                id="returnDate"
                name="returnDate"
                type="date"
                aria-describedby="returnDateError">
          <small id="returnDateError" class="error" aria-live="polite"></small>
        </div>
      </div>

      <div style="margin-top: 16px;">
        <button class="btn" type="submit" style="width: 100%;">SEARCH FLIGHTS</button>
        <div id="homepageFormStatus" style="margin-top: 8px; color: var(--danger); font-weight: bold;" aria-live="polite"></div>
      </div>

      <datalist id="destinationsList">
        {% for d in destinations %}
        <option value="{{ d }}"></option>
        {% endfor %}
      </datalist>
    </div>

    <h3 style="margin-top: 32px;">Available Flights</h3>
    <div id="flight-results">
      <div class="card" style="text-align: center; padding: 40px 20px;">
        <p class="muted" style="margin: 0;">Search above to get results</p>
      </div>
    </div>
  </section>

</form>

<script>
(function () {

  const form = document.getElementById("homepageSearchForm");
  const fromEl = document.getElementById("from");
  const toEl = document.getElementById("to");
  const departEl = document.getElementById("depart");
  const statusEl = document.getElementById("homepageFormStatus");

  const fromErr = document.getElementById("fromError");
  const toErr = document.getElementById("toError");
  const departErr = document.getElementById("departError");

  if (!form) return;

  const allowedValues = new Set(
    Array.from(document.querySelectorAll("#destinationsList option"))
      .map(o => (o.value || "").trim().toLowerCase())
  );

  const today = new Date();
  const todayStr = today.toISOString().split("T")[0];
  departEl.min = todayStr;

  const tripTypeEl = document.getElementById("tripType");
  const returnDateEl = document.getElementById("returnDate");
  const returnDateField = document.getElementById("returnDateField");
  const returnDateErr = document.getElementById("returnDateError");

  returnDateEl.min = todayStr;

  function updateReturnDateVisibility() {
    const isRoundTrip = tripTypeEl.value === "roundTrip";
    returnDateField.style.display = isRoundTrip ? "block" : "none";
    returnDateEl.required = isRoundTrip;

    if (!isRoundTrip) {
      returnDateEl.value = "";
      setError(returnDateEl, returnDateErr, "");
    }
  }

  function setError(input, errorNode, message) {
    if (!input || !errorNode) return;

    if (message) {
      input.setAttribute("aria-invalid", "true");
      errorNode.textContent = message;
    } else {
      input.removeAttribute("aria-invalid");
      errorNode.textContent = "";
    }
  }

  function resetErrors() {
    setError(fromEl, fromErr, "");
    setError(toEl, toErr, "");
    setError(departEl, departErr, "");
    setError(returnDateEl, returnDateErr, "");
    if (statusEl) statusEl.textContent = "";
  }

  tripTypeEl.addEventListener("change", updateReturnDateVisibility);
  updateReturnDateVisibility();

  function isAllowedDestination(value) {
    return allowedValues.has((value || "").trim().toLowerCase());
  }

  function toUkDate(date) {
    const parts = date.split("-");
    return parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : date;
  }

  document.body.addEventListener("htmx:configRequest", function (event) {
    if (departEl.value) {
      event.detail.parameters.depart = toUkDate(departEl.value);
    }

    if (returnDateEl.value) {
      event.detail.parameters.returnDate = toUkDate(returnDateEl.value);
    }
  });

  document.body.addEventListener("htmx:beforeRequest", function (event) {

    resetErrors();

    const fromValue = fromEl.value.trim();
    const toValue = toEl.value.trim();
    const departValue = departEl.value;
    const tripType = tripTypeEl.value;
    const returnDateValue = returnDateEl.value;

    let valid = true;

    if (!isAllowedDestination(fromValue)) {
      setError(fromEl, fromErr, "Please select a valid origin from the list.");
      valid = false;
    }

    if (!isAllowedDestination(toValue)) {
      setError(toEl, toErr, "Please select a valid destination from the list.");
      valid = false;
    }

    if (fromValue && toValue && fromValue.toLowerCase() === toValue.toLowerCase()) {
      setError(toEl, toErr, "Destination must be different from origin.");
      valid = false;
    }

    if (!departValue) {
      setError(departEl, departErr, "Please choose a departure date.");
      valid = false;
    } 
    else if (departValue < todayStr) {
      setError(departEl, departErr, "Past dates are not allowed.");
      valid = false;
    }

    if (tripType === "roundTrip") {
      if (!returnDateValue) {
        setError(returnDateEl, returnDateErr, "Please choose a return date.");
        valid = false;
      } else if (returnDateValue < departValue) {
        setError(returnDateEl, returnDateErr, "Return date must be after departure date.");
        valid = false;
      }
    }

    if (!valid) {
      event.preventDefault();
    }

  });

  {% if hasInitialSearch %}
  window.addEventListener("load", function () {
  htmx.trigger(form, "submit");
  });
  {% endif %}

})();
</script>

{% endblock %}