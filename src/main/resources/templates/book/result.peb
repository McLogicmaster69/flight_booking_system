{% extends "_layout/base.peb" %}

{% set activePage = 'book/result' %}
{% set inNav = true %}

{% block content %}

<h2>{{ start }} to {{ end }}</h2>
<h3>{{ date }}</h3>
<h3>{% if layovers == 0 %}Direct{% elseif layovers == 1 %}{{ layovers }} Layover{% else %}{{ layovers }} Layovers{% endif %}</h3>

<br>
<h2>Flights</h2>
{% for flight in flightInfo %}

<div class="flight-search-card">
    <h3>{{ flight.startDestination }} to {{ flight.endDestination }}</h3>
    <h4>{{ flight.dateTime }}</h4>
    <form action="/checkout" method="post">

        <input type="hidden" name="tickets" id="ticketsInput" value="1">
        <input type="hidden" name="start" value="{{ flight.startDestination }}">
        <input type="hidden" name="end" value="{{ flight.endDestination }}">
        <input type="hidden" name="dateTime" value="{{ flight.dateTime }}">

        <div>
            <button type="button" onclick="changeTickets(-1)">-</button>
            <span id="ticketCount">1</span>
            <button type="button" onclick="changeTickets(1)">+</button>
        </div>

        <br>

        <button type="submit" onclick="updateTickets()">Continue</button>
    </form>
</div>
<br>

{% endfor %}

<script>
    let tickets = 1;

    function changeTickets(amount) {
        tickets += amount;

        if (tickets < 1) tickets = 1; // prevent going below 1

        document.getElementById("ticketCount").innerText = tickets;
    }

    function updateTickets() {
        document.getElementById("ticketsInput").value = tickets;
    }
</script>

{% endblock %}
