{% extends "_layout/base.peb" %}

{% set activePage = 'home' %}

{% block content %}

<section aria-label="Hero Image Placeholder">
    <div style="padding: 48px 0;">
        <div style="max-width: 780px; margin: 0 auto;">
            <h2 style="text-align:center;">Where to next?</h2>

            <form method="get" action="/book" aria-label="Search flights">
                <div>
                    <input class="general-input-input" name="from" type="text" placeholder="From (Origin)" aria-label="From (Origin)" required>
                </div>
                <div>
                    <input class="general-input-input" name="to" type="text" placeholder="To (Destination)" aria-label="To (Destination)" required>
                </div>
                <div>
                    <input class="general-input-input" name="depart" type="text" placeholder="dd/mm/yyyy" aria-label="Depart date" required>
                </div>
                <div style="flex: 0 0 auto;">
                    <button type="submit">SEARCH FLIGHTS</button>
                </div>
            </form>
        </div>
    </div>
</section>

<section aria-label="Recommended Deals & Loyalty Rewards" style="margin-top: 34px;">
    
</section>

{% endblock %}
