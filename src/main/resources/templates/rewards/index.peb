{% extends "_layout/base.peb" %}

{% set activePage = 'rewards' %}

{% block content %}

{% if not isLoggedIn %}
  <div style="margin-bottom: 14px;">
    <strong>Disclaimer:</strong>
    Redeeming points is only available to registered users.
    <a href="/login">Login or Sign up here</a>.
  </div>
{% endif %}

<div style="text-align:center; margin-bottom: 18px;">
  <div style="color: var(--muted);"><strong>Your Current Balance</strong></div>
</div>

<h3>Redeemable Now</h3>

<h3>Almost There (Within 1000 pts)</h3>

{% endblock %}
