{% extends "_layout/base.peb" %}

{% set activePage = 'manage' %}
{% set inNav = true %}

{% block content %}

<h2>Manage Bookings</h2>

<div>
  <h3 style="margin-top: 0;">Find a Booking</h3>
  <div></div>

  <form method="post" action="/handleBookingSearch" aria-label="Find a booking">
    <div><input class="general-input" type="text" name="ref" placeholder="Ref Number Input" aria-label="Reference number"></div>
    <div><input class="general-input" type="text" name="last" placeholder="Last Name Input" aria-label="Last name"></div>
    <div style="flex:0 0 auto;"><button type="submit">FIND BOOKING</button></div>
  </form>
</div>

<div class="booking-results">
    {% for row in searchResults %}
        <div class="booking-card">

            <div class="booking-header">
                <strong>Booking Reference :</strong> {{ row[0] }}
            </div>

            <div class="booking-body">
              <p><strong>Name :</strong> {{ row[1] }}</p>
              <p><strong>From :</strong> {{ row[7] }}</p>
              <p><strong>To :</strong> {{ row[8] }}</p>
              <p><strong>Date :</strong> {{ row[2] }}</p>
              <p><strong>Time :</strong> {{ row[3] }}</p>
              <p><strong>Seat :</strong> {{ row[4] }}</p>
              <p><strong>Class :</strong> {{ row[5] }}</p>
              <p><strong>Ticket Type :</strong> {{ row[6] }}</p>
          </div>

          <form method="post" action="/manage/refund">
            <input type="hidden" name="bookingRef" value="{{ row[0] }}">
            <input type="hidden" name="last" value="{{ row[1] }}">
            <button type="submit" onclick="return confirm('Cancel this booking and issue a full refund?');">
              Cancel booking and refund
            </button>
          </form>

        </div>
    {% endfor %}
</div>

{% if logged_in and userBookings is not empty %}
  <h3>Your Current Bookings</h3>

  <div class="booking-results">
    {% for booking in userBookings %}
      <div class="booking-card">
        <div class="booking-header">
          <strong>Booking Reference :</strong> {{ booking[0] }}
        </div>

        <div class="booking-body">
            <p><strong>Name :</strong> {{ booking[1] }}</p>
            <p><strong>From :</strong> {{ booking[7] }}</p>
            <p><strong>To :</strong> {{ booking[8] }}</p>
            <p><strong>Date :</strong> {{ booking[2] }}</p>
            <p><strong>Time :</strong> {{ booking[3] }}</p>
            <p><strong>Seat :</strong> {{ booking[4] }}</p>
            <p><strong>Class :</strong> {{ booking[5] }}</p>
            <p><strong>Ticket Type :</strong> {{ booking[6] }}</p>
        </div>

        <form method="post" action="/manage/refund">
            <input type="hidden" name="bookingRef" value="{{ booking[0] }}">
            <input type="hidden" name="last" value="{{ booking[1] }}">
            <button type="submit" onclick="return confirm('Cancel this booking and issue a full refund?');">
              Cancel booking and refund
            </button>
        </form>
      </div>
    {% endfor %}
  </div>
{% endif %}

{% endblock %}
