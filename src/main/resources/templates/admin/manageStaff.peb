    {% extends "_layout/base.peb" %}

        {% set layout = 'admin' %}
        {% set activePage = 'manageStaff' %}
        {% set inNav = true %}

    {% block content %}

<h2 class="wf-title">Manage Staff</h2>
<div class="wf-rule"></div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start;">

    <section>
        <div class="card" style="margin-bottom: 24px;">
            <h3 style="margin-top: 0;">Existing Staff</h3>

            <form class="auth-form" method="get" action="/manageStaff">
                <label class="auth-label">Search Staff</label>
                <input
                    class="auth-input"
                    name="search"
                    type="text"
                    value="{{ search }}"
                    placeholder="Search by first or last name">

                <button class="wf-btn wide" type="submit" style="margin-top: 12px;">
                    Search
                </button>
            </form>
        </div>

        {% for member in staff %}

            <div class="card" style="margin-bottom: 16px;">
                <h3 style="margin-top: 0;">{{ member.firstName }} {{ member.lastName }}</h3>

                <div class="muted">
                    <p style="margin: 4px 0;">Email: {{ member.email }}</p>
                    <p style="margin: 4px 0;">Position: {{ member.positionName }}</p>
                </div>

                <a class="wf-btn" href="/manageStaff/edit/{{ member.id }}" style="margin-top: 14px; display: inline-block;">Edit Staff</a>
            </div>

        {% else %}

            <p>No staff accounts found.</p>

        {% endfor %}

        {% if totalPages > 1 %}
            <div style="display: flex; gap: 12px; align-items: center; margin-top: 18px;">
                {% if page > 1 %}
                    <a class="wf-btn" href="/manageStaff?page={{ page - 1 }}&search={{ search }}">Previous</a>
                {% endif %}

                <span>Page {{ page }} of {{ totalPages }}</span>

                {% if page < totalPages %}
                    <a class="wf-btn" href="/manageStaff?page={{ page + 1 }}&search={{ search }}">Next</a>
                {% endif %}
            </div>
        {% endif %}
    </section>

    <section>
        <div class="card">
            <h3 style="margin-top: 0;">Create Staff Account</h3>

            <form
                class="auth-form"
                method="post"
                action="/manageStaff/create"
                hx-post="/manageStaff/create"
                hx-target="#create-staff-status"
                hx-swap="innerHTML">

                <label class="auth-label">First Name</label>
                <input class="auth-input" name="firstName" type="text" placeholder="First Name">

                <label class="auth-label">Last Name</label>
                <input class="auth-input" name="lastName" type="text" placeholder="Last Name">

                <label class="auth-label">Position</label>
                <select class="auth-input" name="positionId">
                    {% for position in positions %}
                        <option value="{{ position.id }}">{{ position.name }}</option>
                    {% endfor %}
                </select>

                <label class="auth-label">Home Country</label>
                <select class="auth-input" name="homeId">
                    {% for country in countries %}
                        <option value="{{ country.id }}">{{ country.name }}</option>
                    {% endfor %}
                </select>

                <label class="auth-label">Current Location</label>
                <select class="auth-input" name="currentLocation">
                    {% for destination in destinations %}
                        <option value="{{ destination.id }}">{{ destination.cityName }}</option>
                    {% endfor %}
                </select>

                <label class="auth-label">Email</label>
                <input class="auth-input" name="email" type="email" placeholder="Email">

                <label class="auth-label">Password</label>
                <input class="auth-input" name="password" type="password" placeholder="Password">

                <div style="margin-top: 14px;"></div>
                <button class="wf-btn wide" type="submit">Create Staff Account</button>

                <div id="create-staff-status" role="status" aria-live="polite"></div>
            </form>
        </div>
    </section>

</div>

{% endblock %}