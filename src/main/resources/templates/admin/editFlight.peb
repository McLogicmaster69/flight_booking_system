{% extends "_layout/base.peb" %}

{% set layout = 'admin' %}
{% set activePage = 'manageFlights' %}
{% set inNav = true %}

{% block content %}

<h2 class="wf-title">Edit Flight</h2>
<div class="wf-rule"></div>

<form class="auth-form" method="post" action="/manageFlights/update" hx-post="/manageFlights/update">

    <input type="hidden" name="flightId" value="{{ flight.id }}">

    <label class="auth-label">Route</label>
    <select class="auth-input" name="routeId">
        {% for route in routes %}
            <option value="{{ route.id }}" {% if route.id == flight.routeId %}selected{% endif %}>
                {{ routeNames[route.id] }}
            </option>
        {% endfor %}
    </select>

    <label class="auth-label">Plane</label>
    <select class="auth-input" name="planeId">
        {% for plane in planes %}
            <option value="{{ plane.id }}" {% if plane.id == flight.planeId %}selected{% endif %}>
                {{ plane.registrationCode }}
            </option>
        {% endfor %}
    </select>

    <label class="auth-label">Date</label>
    <input class="auth-input" name="date" type="date" value="{{ flight.date }}">

    <label class="auth-label">Time</label>
    <input class="auth-input" name="time" type="time" value="{{ flight.time }}">

    <div style="display: flex; gap: 12px; margin-top: 14px;">
        <button class="wf-btn" type="submit">Save Changes</button>

        <button
            class="wf-btn"
            type="button"
            hx-post="/manageFlights/delete"
            hx-vals='{"flightId":"{{ flight.id }}"}'>
            Delete Flight and Refund Tickets
        </button>

        <a class="wf-btn" href="/manageFlights">Back</a>
    </div>

</form>

{% endblock %}