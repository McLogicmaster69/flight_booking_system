    {% extends "_layout/base.peb" %}

        {% set layout = 'admin' %}
        {% set activePage = 'manageFlights' %}
        {% set inNav = true %}

    {% block content %}

<h2 class="wf-title">Flight Details</h2>
<div class="wf-rule"></div>

<div class="card" style="margin-bottom: 32px;">
    <h3 style="margin-top: 0;">{{ routeName }}</h3>

    <div class="muted">
        <p style="margin: 4px 0;">Plane: {{ planeRegistrationCode }}</p>
        <p style="margin: 4px 0;">Date: {{ flight.date }} {{ flight.time }}</p>
    </div>
</div>

<section>
    <div class="card" style="margin-bottom: 24px;">
        <h3 style="margin-top: 0;">Reservations</h3>

        <form class="auth-form" method="get" action="/manageFlights/details/{{ flight.id }}">
            <label class="auth-label">Search Reservations</label>

            <input
                class="auth-input"
                name="search"
                type="text"
                value="{{ search }}"
                placeholder="Search by booking reference, email, or seat ID">

            <button class="wf-btn wide" type="submit" style="margin-top: 12px;">
                Search Reservations
            </button>
        </form>
    </div>

    {% for reservation in reservations %}

        <div class="card" style="margin-bottom: 16px;">
            <h3 style="margin-top: 0;">{{ reservation.bookingReference }}</h3>

            <div class="muted">
                <p style="margin: 4px 0;">Email: {{ reservation.bookerEmail }}</p>
                <p style="margin: 4px 0;">Seat ID: {{ reservation.seatId }}</p>
                <p style="margin: 4px 0;">Amount Paid: {{ reservation.amountPaidDisplay }}</p>
                <p style="margin: 4px 0;">Refund Status: {{ reservation.refundStatus }}</p>
            </div>
        </div>

    {% else %}

        <p>No reservations found.</p>

    {% endfor %}

        {% if totalPages > 1 %}
        <div style="display: flex; gap: 12px; align-items: center; margin-top: 18px;">
            {% if page > 1 %}
                <a class="wf-btn" href="/manageFlights/details/{{ flight.id }}?page={{ page - 1 }}&search={{ search }}">
                    Previous
                </a>
            {% endif %}

            <span>Page {{ page }} of {{ totalPages }}</span>

            {% if page < totalPages %}
                <a class="wf-btn" href="/manageFlights/details/{{ flight.id }}?page={{ page + 1 }}&search={{ search }}">
                    Next
                </a>
            {% endif %}
        </div>
    {% endif %}

    <div style="margin-top: 18px;">
        <a class="wf-btn" href="/manageFlights">Back</a>
    </div>
</section>

{% endblock %}