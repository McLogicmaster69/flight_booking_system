{% extends "_layout/base.peb" %}

{% set layout = 'admin' %}
{% set activePage = 'managePlaneData' %}
{% set inNav = true %}

{% block content %}

<h2 class="wf-title">Edit Manufacturer</h2>
<div class="wf-rule"></div>

<form
    class="auth-form"
    method="post"
    action="/managePlaneData/manufacturer/update"
    hx-post="/managePlaneData/manufacturer/update">

    <input type="hidden" name="manufacturerId" value="{{ manufacturer.id }}">

    <label class="auth-label">Manufacturer Name</label>
    <input class="auth-input" name="name" type="text" value="{{ manufacturer.name }}">

    <div style="display: flex; gap: 12px; margin-top: 14px;">
        <button class="wf-btn" type="submit">Save Changes</button>

        <button
            class="wf-btn"
            type="button"
            hx-post="/managePlaneData/manufacturer/delete"
            hx-vals='{"manufacturerId":"{{ manufacturer.id }}"}'
            hx-target="#manufacturer-status"
            hx-swap="innerHTML">
            Delete Manufacturer
        </button>

        <a class="wf-btn" href="/managePlaneData">Back</a>
    </div>

    <div id="manufacturer-status" role="status" aria-live="polite"></div>

</form>

{% endblock %}