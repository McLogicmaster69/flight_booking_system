{% extends "_layout/base.peb" %}

{% set layout = 'admin' %}
{% set activePage = 'manageRoutes' %}
{% set inNav = true %}

{% block content %}

<h2 class="wf-title">Manage Routes</h2>
<div class="wf-rule"></div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start;">

    <section>
        <h3>Registered Routes</h3>

        <form class="auth-form" method="get" action="/manageRoutes">
            <label class="auth-label">Search Routes</label>
            <input
                class="auth-input"
                name="search"
                type="text"
                value="{{ search }}"
                placeholder="Search by start or end destination">

            <button class="wf-btn wide" type="submit" style="margin-top: 6px;">
                Search Routes
            </button>
        </form>

        <div class="wf-rule"></div>

        {% for route in routes %}
            <form class="auth-form" method="post" action="/manageRoutes/update" hx-post="/manageRoutes/update">

                <input type="hidden" name="routeId" value="{{ route.id }}">

                <label class="auth-label">Start Destination</label>
                <select class="auth-input" name="startDestination">
                    {% for destination in destinations %}
                        <option value="{{ destination.id }}" {% if destination.id == route.startDestination %}selected{% endif %}>
                            {{ destination.cityName }}
                        </option>
                    {% endfor %}
                </select>

                <label class="auth-label">End Destination</label>
                <select class="auth-input" name="endDestination">
                    {% for destination in destinations %}
                        <option value="{{ destination.id }}" {% if destination.id == route.endDestination %}selected{% endif %}>
                            {{ destination.cityName }}
                        </option>
                    {% endfor %}
                </select>

                <label class="auth-label">Duration</label>
                <input class="auth-input" name="duration" type="time" value="{{ route.duration }}">

                <div style="display: flex; gap: 12px; margin-top: 14px;">
                    <button class="wf-btn" type="submit">Save Changes</button>

                    <button
                        class="wf-btn"
                        type="button"
                        hx-post="/manageRoutes/delete"
                        hx-vals='{"routeId":"{{ route.id }}"}'>
                        Delete Route
                    </button>
                </div>
            </form>

            <div class="wf-rule"></div>
        {% else %}
            <p>No routes found.</p>
        {% endfor %}

        {% if totalPages > 1 %}
            <div style="display: flex; gap: 12px; align-items: center; margin-top: 18px;">
                {% if page > 1 %}
                    <a class="wf-btn" href="/manageRoutes?page={{ page - 1 }}&search={{ search }}">Previous</a>
                {% endif %}

                <span>Page {{ page }} of {{ totalPages }}</span>

                {% if page < totalPages %}
                    <a class="wf-btn" href="/manageRoutes?page={{ page + 1 }}&search={{ search }}">Next</a>
                {% endif %}
            </div>
        {% endif %}
    </section>

    <section>
        <h3>Register Route</h3>

        <form class="auth-form" method="post" action="/manageRoutes/create" hx-post="/manageRoutes/create">

            <label class="auth-label">Start Destination</label>
            <select class="auth-input" name="startDestination">
                {% for destination in destinations %}
                    <option value="{{ destination.id }}">{{ destination.cityName }}</option>
                {% endfor %}
            </select>

            <label class="auth-label">End Destination</label>
            <select class="auth-input" name="endDestination">
                {% for destination in destinations %}
                    <option value="{{ destination.id }}">{{ destination.cityName }}</option>
                {% endfor %}
            </select>

            <label class="auth-label">Duration</label>
            <input class="auth-input" name="duration" type="time" value="00:00">

            <div style="margin-top: 14px;"></div>
            <button class="wf-btn wide" type="submit">Register Route</button>
        </form>
    </section>

</div>

{% endblock %}