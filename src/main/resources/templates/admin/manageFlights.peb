    {% extends "_layout/base.peb" %}

        {% set layout = 'admin' %}
        {% set activePage = 'manageFlights' %}
        {% set inNav = true %}

    {% block content %}

<h2 class="wf-title">Manage Flights</h2>
<div class="wf-rule"></div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start;">

    <section>
        <div class="card" style="margin-bottom: 24px;">
            <h3 style="margin-top: 0;">Registered Flights</h3>

            <form class="auth-form" method="get" action="/manageFlights">
                <label class="auth-label">Search Flights</label>
                <input
                    class="auth-input"
                    name="search"
                    type="text"
                    value="{{ search }}"
                    placeholder="Search by route, plane, date, or time">

                <button class="wf-btn wide" type="submit" style="margin-top: 12px;">
                    Search Flights
                </button>
            </form>
        </div>

        {% for flight in flights %}

            <div class="card" style="margin-bottom: 16px;">
                <h3 style="margin-top: 0;">{{ flight.routeName }}</h3>

                <div class="muted">
                    <p style="margin: 4px 0;">Plane: {{ flight.planeRegistrationCode }}</p>
                    <p style="margin: 4px 0;">Date: {{ flight.date }}</p>
                    <p style="margin: 4px 0;">Time: {{ flight.time }}</p>
                </div>

                <div style="display: flex; gap: 12px; margin-top: 14px; flex-wrap: wrap;">
                    <a class="wf-btn" href="/manageFlights/edit/{{ flight.id }}">Edit Flight</a>
                    <a class="wf-btn" href="/manageFlights/details/{{ flight.id }}">View Reservations</a>
                </div>
            </div>

        {% else %}

            <p>No flights found.</p>

        {% endfor %}

        {% if totalPages > 1 %}
            <div style="display: flex; gap: 12px; align-items: center; margin-top: 18px;">
                {% if page > 1 %}
                    <a class="wf-btn" href="/manageFlights?page={{ page - 1 }}&search={{ search }}">Previous</a>
                {% endif %}

                <span>Page {{ page }} of {{ totalPages }}</span>

                {% if page < totalPages %}
                    <a class="wf-btn" href="/manageFlights?page={{ page + 1 }}&search={{ search }}">Next</a>
                {% endif %}
            </div>
        {% endif %}
    </section>

    <section>
        <div class="card">
            <h3 style="margin-top: 0;">Register Flight</h3>

            <form
                class="auth-form"
                method="post"
                action="/manageFlights/create"
                hx-post="/manageFlights/create"
                hx-target="#create-flight-status"
                hx-swap="innerHTML">

                <label class="auth-label">Route</label>
                <select class="auth-input" name="routeId">
                    {% for route in routes %}
                        <option value="{{ route.id }}">{{ routeNames[route.id] }}</option>
                    {% endfor %}
                </select>

                <label class="auth-label">Plane</label>
                <select class="auth-input" name="planeId">
                    {% for plane in planes %}
                        <option value="{{ plane.id }}">{{ plane.registrationCode }}</option>
                    {% endfor %}
                </select>

                <label class="auth-label">Date</label>
                <input class="auth-input" name="date" type="date">

                <label class="auth-label">Time</label>
                <input class="auth-input" name="time" type="time" value="00:00">

                <div style="margin-top: 14px;"></div>
                <button class="wf-btn wide" type="submit">Register Flight</button>

                <div id="create-flight-status" role="status" aria-live="polite" style="margin-top: 12px;"></div>
            </form>
        </div>
    </section>

</div>

{% endblock %}