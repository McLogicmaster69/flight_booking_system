    {% extends "_layout/base.peb" %}

        {% set layout = 'admin' %}
        {% set activePage = 'managePlaneData' %}
        {% set inNav = true %}

    {% block content %}

<h2 class="wf-title">Manage Plane Data</h2>
<div class="wf-rule"></div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start;">

    <section>
        <div class="card" style="margin-bottom: 24px;">
            <h3 style="margin-top: 0;">Registered Models</h3>

            <form class="auth-form" method="get" action="/managePlaneData">
                <input type="hidden" name="manufacturerSearch" value="{{ manufacturerSearch }}">
                <input type="hidden" name="manufacturerPage" value="{{ manufacturerPage }}">

                <div style="display: flex; flex-direction: column; gap: 4px;">
                    <label class="auth-label" style="margin-bottom: 0;">
                        Search Models
                    </label>

                    <input
                        class="auth-input"
                        name="modelSearch"
                        type="text"
                        value="{{ modelSearch }}"
                        placeholder="Search by model or manufacturer">
                </div>

                <button class="wf-btn wide" type="submit" style="margin-top: 12px;">Search Models</button>
            </form>
        </div>

        {% for model in models %}

            <div class="card" style="margin-bottom: 16px;">
                <h3 style="margin-top: 0;">{{ model.name }}</h3>

                <div class="muted">
                    <p style="margin: 4px 0;">Manufacturer: {{ model.manufacturerName }}</p>
                    <p style="margin: 4px 0;">Capacity: {{ model.capacity }}</p>
                    <p style="margin: 4px 0;">Pilots: {{ model.pilots }} | Attendants: {{ model.attendants }}</p>
                </div>

                <a class="wf-btn" href="/managePlaneData/model/edit/{{ model.id }}" style="margin-top: 14px; display: inline-block;">Edit Model</a>
            </div>

        {% else %}

            <p>No plane models found.</p>

        {% endfor %}

        {% if totalModelPages > 1 %}
            <div style="display: flex; gap: 12px; align-items: center; margin-top: 18px;">
                {% if modelPage > 1 %}
                    <a class="wf-btn" href="/managePlaneData?modelPage={{ modelPage - 1 }}&modelSearch={{ modelSearch }}&manufacturerPage={{ manufacturerPage }}&manufacturerSearch={{ manufacturerSearch }}">Previous</a>
                {% endif %}

                <span>Page {{ modelPage }} of {{ totalModelPages }}</span>

                {% if modelPage < totalModelPages %}
                    <a class="wf-btn" href="/managePlaneData?modelPage={{ modelPage + 1 }}&modelSearch={{ modelSearch }}&manufacturerPage={{ manufacturerPage }}&manufacturerSearch={{ manufacturerSearch }}">Next</a>
                {% endif %}
            </div>
        {% endif %}

    </section>

    <section>
        <div class="card">
            <h3 style="margin-top: 0;">Register Model</h3>

            <form
                class="auth-form"
                method="post"
                action="/managePlaneData/model/create"
                hx-post="/managePlaneData/model/create"
                hx-target="#create-model-status"
                hx-swap="innerHTML">

                <label class="auth-label">Model Name</label>
                <input class="auth-input" name="name" type="text" placeholder="Model Name">

                <label class="auth-label">Manufacturer</label>
                <select class="auth-input" name="manufacturerId">
                    {% for manufacturer in allManufacturers %}
                        <option value="{{ manufacturer.id }}">{{ manufacturer.name }}</option>
                    {% endfor %}
                </select>

                <label class="auth-label">Capacity</label>
                <input class="auth-input" name="capacity" type="number" min="1" placeholder="Capacity">

                <label class="auth-label">Pilots</label>
                <input class="auth-input" name="pilots" type="number" min="1" placeholder="Pilots">

                <label class="auth-label">Attendants</label>
                <input class="auth-input" name="attendants" type="number" min="0" placeholder="Attendants">

                <div style="margin-top: 14px;"></div>
                <button class="wf-btn wide" type="submit">Register Model</button>

                <div id="create-model-status" role="status" aria-live="polite"></div>
            </form>
        </div>
    </section>

</div>

<div class="wf-rule"></div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start;">

    <section>
        <div class="card" style="margin-bottom: 24px;">
            <h3 style="margin-top: 0;">Registered Manufacturers</h3>

            <form class="auth-form" method="get" action="/managePlaneData">
                <input type="hidden" name="modelSearch" value="{{ modelSearch }}">
                <input type="hidden" name="modelPage" value="{{ modelPage }}">

                <div style="display: flex; flex-direction: column; gap: 4px;">
                    <label class="auth-label" style="margin-bottom: 0;">
                        Search Manufacturers
                    </label>

                    <input
                        class="auth-input"
                        name="manufacturerSearch"
                        type="text"
                        value="{{ manufacturerSearch }}"
                        placeholder="Search by manufacturer name">
                </div>

                <button class="wf-btn wide" type="submit" style="margin-top: 12px;">Search Manufacturers</button>
            </form>
        </div>

        {% for manufacturer in manufacturers %}

            <div class="card" style="margin-bottom: 16px;">
                <h3 style="margin-top: 0;">{{ manufacturer.name }}</h3>
                <a class="wf-btn" href="/managePlaneData/manufacturer/edit/{{ manufacturer.id }}" style="margin-top: 14px; display: inline-block;">Edit Manufacturer</a>
            </div>

        {% else %}

            <p>No manufacturers found.</p>

        {% endfor %}

        {% if totalManufacturerPages > 1 %}
            <div style="display: flex; gap: 12px; align-items: center; margin-top: 18px;">
                {% if manufacturerPage > 1 %}
                    <a class="wf-btn" href="/managePlaneData?manufacturerPage={{ manufacturerPage - 1 }}&manufacturerSearch={{ manufacturerSearch }}&modelPage={{ modelPage }}&modelSearch={{ modelSearch }}">Previous</a>
                {% endif %}

                <span>Page {{ manufacturerPage }} of {{ totalManufacturerPages }}</span>

                {% if manufacturerPage < totalManufacturerPages %}
                    <a class="wf-btn" href="/managePlaneData?manufacturerPage={{ manufacturerPage + 1 }}&manufacturerSearch={{ manufacturerSearch }}&modelPage={{ modelPage }}&modelSearch={{ modelSearch }}">Next</a>
                {% endif %}
            </div>
        {% endif %}

    </section>

    <section>
        <div class="card">
            <h3 style="margin-top: 0;">Register Manufacturer</h3>

            <form
                class="auth-form"
                method="post"
                action="/managePlaneData/manufacturer/create"
                hx-post="/managePlaneData/manufacturer/create"
                hx-target="#create-manufacturer-status"
                hx-swap="innerHTML">

                <label class="auth-label">Manufacturer Name</label>
                <input class="auth-input" name="name" type="text" placeholder="Manufacturer Name">

                <div style="margin-top: 14px;"></div>
                <button class="wf-btn wide" type="submit">Register Manufacturer</button>

                <div id="create-manufacturer-status" role="status" aria-live="polite"></div>
            </form>
        </div>
    </section>

</div>

{% endblock %}