{% extends "_layout/base.peb" %}

{% set layout = 'admin' %}
{% set activePage = 'managePlanes' %}
{% set inNav = true %}

{% block content %}

<h2 class="wf-title">Manage Planes</h2>
<div class="wf-rule"></div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start;">

    <section>
        <h3>Registered Planes</h3>

        <form class="auth-form" method="get" action="/managePlanes">
            <label class="auth-label">Search Planes</label>
            <input
                class="auth-input"
                name="search"
                type="text"
                value="{{ search }}"
                placeholder="Search by registration, model, or location">

            <button class="wf-btn wide" type="submit" style="margin-top: 6px; margin-bottom: 12px;">
                Search Planes
            </button>
        </form>

        <div class="wf-rule"></div>

        {% for plane in planes %}

            <div class="staff-flight-assignment">
                <a href="/managePlanes/edit/{{ plane.id }}" class="staff-flight-button">
                    <h2>{{ plane.registrationCode }}</h2>

                    <div class="staff-flight-info">
                        <p>Model: {{ plane.modelName }}</p>
                        <p>Location: {{ plane.currentLocationName }}</p>
                        <p>Available from: {{ plane.currentLocationDate }} {{ plane.currentLocationTime }}</p>
                    </div>
                </a>
            </div>

            <br>

        {% else %}

            <p>No planes found.</p>

        {% endfor %}

        {% if totalPages > 1 %}
            <div style="display: flex; gap: 12px; align-items: center; margin-top: 18px;">
                {% if page > 1 %}
                    <a class="wf-btn" href="/managePlanes?page={{ page - 1 }}&search={{ search }}">Previous</a>
                {% endif %}

                <span>Page {{ page }} of {{ totalPages }}</span>

                {% if page < totalPages %}
                    <a class="wf-btn" href="/managePlanes?page={{ page + 1 }}&search={{ search }}">Next</a>
                {% endif %}
            </div>
        {% endif %}
    </section>

    <section>
        <h3>Register Plane Into Database</h3>

        <form
            class="auth-form"
            method="post"
            action="/managePlanes/create"
            hx-post="/managePlanes/create">

            <label class="auth-label">Registration Code</label>
            <input class="auth-input" name="registrationCode" type="text" placeholder="Registration Code">

            <label class="auth-label">Model</label>
            <select class="auth-input" name="modelId">
                {% for model in models %}
                    <option value="{{ model.id }}">{{ model.name }}</option>
                {% endfor %}
            </select>

            <label class="auth-label">Current Location</label>
            <select class="auth-input" name="currentLocation">
                {% for destination in destinations %}
                    <option value="{{ destination.id }}">{{ destination.cityName }}</option>
                {% endfor %}
            </select>

            <label class="auth-label">Current Location Date</label>
            <input class="auth-input" name="currentLocationDate" type="date" value="1970-01-01">

            <label class="auth-label">Current Location Time</label>
            <input class="auth-input" name="currentLocationTime" type="time" value="00:00">

            <div style="margin-top: 14px;"></div>
            <button class="wf-btn wide" type="submit">Register Plane</button>
        </form>
    </section>

</div>

{% endblock %}