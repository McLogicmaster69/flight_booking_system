{% extends "_layout/base.peb" %}

{% set headerRightText = '' %}

{% block content %}

<div>
  <div>
    <h2>403 • Forbidden</h2>
    <div></div>
    <p style="color: var(--wf-muted);">You don’t have access to this page.</p>
    <div style="display:flex; gap: 12px; flex-wrap: wrap; margin-top: 12px;">
      <a href="/" style="text-decoration:none; display:inline-block;">Go home</a>
      <a href="/login" style="text-decoration:none; display:inline-block;">Login</a>
    </div>
  </div>
</div>

{% endblock %}
