    {% extends "_layout/base.peb" %}
        {% set activePage = 'payment' %}
        {% set inNav = true %}
        {% set headerRightText = 'Payment' %}

    {% block content %}
<h2 class="wf-title">Secure Payment</h2>
<div class="wf-rule"></div>

<div class="card" style="max-width: 500px; margin: 0 auto;">
    {% if logged_in %}
        <p class="muted" style="margin-bottom: 16px;"><strong>Email:</strong> {{ userEmail }}</p>
        <input type="hidden" id="email" value="{{ userEmail }}">
    {% else %}
        <div class="auth-form" style="margin-bottom: 16px;">
            <label class="auth-label">Email</label>
            <input class="auth-input" type="email" id="email" required placeholder="Enter your email">
        </div>
    {% endif %}

    <h3 style="margin-top: 0;">Total: £{{ displayTotal }}</h3>

    <form id="payment-form" class="auth-form" style="margin-top: 16px;">
        <label class="auth-label">Card Details</label>

        <div id="card-element" class="auth-input" style="padding: 12px; background: white;"></div>

        <button type="submit" class="wf-btn wide pay-btn" style="margin-top: 16px;">
            Pay Securely
        </button>
    </form>

    <div id="payment-result" style="margin-top: 12px; color: var(--danger); font-weight: bold;"></div>
</div>

<script src="https://js.stripe.com/v3/"></script>
<script>
    const stripe = Stripe("pk_test_51TCfFDDPNfjFe9UtZt8o4M0A1bqaqfmtRpSII7JJuTZyYPe1WrjULjOaQqa7joNjgtgsM850g1IwDlToKRd91n6B00zS1xptbP");
    const elements = stripe.elements();
    const card = elements.create("card", {
        style: {
            base: {
                fontSize: "15px",
                color: "#333",
                fontFamily: "inherit",
                "::placeholder": {
                    color: "#9ca3af"
                }
            }
        }
    });
    card.mount("#card-element");

    const form = document.getElementById("payment-form");
    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const button = e.target.querySelector(".pay-btn");
        button.disabled = true;
        button.innerText = "🔒 Processing Payment...";

        const emailInput = document.getElementById("email");
        const email = document.getElementById("email")?.value.trim() || "";

        if (!email) {
            document.getElementById("payment-result").innerText = "Email is required.";
            button.disabled = false;
            button.innerText = "Pay Securely";
            return;
        }

        try {
            const res = await fetch("/create-payment-intent", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ email: email, amount: "{{ totalAmount }}" })
            });
            const data = await res.json();

            const result = await stripe.confirmCardPayment(data.clientSecret, {
                payment_method: {
                    card: card,
                    billing_details: {
                        email: email
                    }
                }
            });

            if (result.error) {
                document.getElementById("payment-result").innerText = result.error.message;
                button.disabled = false;
                button.innerText = "Pay Securely";
            } else {
                console.log({
                    {% for selection in selections %}
                    "classId{{ selection.passenger }}_{{ selection.leg }}": "{{ selection.classId }}",
                    "seatId{{ selection.passenger }}_{{ selection.leg }}": "{% if selection.seatId != null %}{{ selection.seatId }}{% endif %}",
                    "typeId{{ selection.passenger }}_{{ selection.leg }}": "{{ selection.typeId }}",
                    {% endfor %}
                });
                const confirmRes = await fetch("/confirm-booking", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: new URLSearchParams({
                        email: email,
                        token: "{{ token }}",
                        tickets: "{{ tickets }}",
                        totalAmount: "{{ totalAmount }}",
                        paymentIntentId: result.paymentIntent.id,
                        {% for i in 1..tickets %}
                        lastName{{ i }}: "{{ lastNames[i-1] }}",
                        passport{{ i }}: "{{ passportNumbers[i-1] }}",
                        {% endfor %}
        {% for selection in selections %}
                        classId{{ selection.passenger }}_{{ selection.leg }}: "{{ selection.classId }}",
                        seatId{{ selection.passenger }}_{{ selection.leg }}: "{% if selection.seatId != null %}{{ selection.seatId }}{% endif %}",
                        typeId{{ selection.passenger }}_{{ selection.leg }}: "{{ selection.typeId }}",
                        {% endfor %}
        {% for u in 1..upgradeCount %}
                        upgradePassenger{{ u }}: "{{ upgradePassengers[u - 1] }}",
                        {% endfor %}
                    })
                });

                if (!confirmRes.ok) {
                    const errorText = await confirmRes.text();
                    document.getElementById("payment-result").innerText = errorText || "Booking failed.";
                    button.disabled = false;
                    button.innerText = "Pay Securely";
                    return;
                }
                window.location.href = "/payment-success";
            }
        } catch (err) {
            document.getElementById("payment-result").innerText = "Something went wrong.";
            button.disabled = false;
            button.innerText = "Pay Securely";
        }
    });
</script>
{% endblock %}