{% extends "_layout/base.peb" %}

{% set activePage = 'payment' %}
{% set inNav = true %}

{% set headerRightText = 'Payment' %}

{% block content %}

<div class="payment-container">

    <div class="payment-card">
        <h2>Secure Payment</h2>

        {% if logged_in %}
            <p class="email-display">Email: {{ userEmail }}</p>
            <input type="hidden" id="email" value="{{ userEmail }}">
        {% else %}
            <div class="form-group">
                <label>Email</label>
                <input type="email" id="email" required placeholder="Enter your email">
            </div>
        {% endif %}

        <form id="payment-form">

            <div class="form-group">
                <label>Card Details</label>
                <div id="card-element" class="stripe-card"></div>
            </div>

            <button type="submit" class="pay-btn">
                Pay Securely
            </button>
        </form>

        <div id="payment-result" class="payment-result"></div>
    </div>

</div>

<script src="https://js.stripe.com/v3/"></script>

<script>
const stripe = Stripe("pk_test_51TCfFDDPNfjFe9UtZt8o4M0A1bqaqfmtRpSII7JJuTZyYPe1WrjULjOaQqa7joNjgtgsM850g1IwDlToKRd91n6B00zS1xptbP");
const elements = stripe.elements();

const card = elements.create("card", {
    style: {
        base: {
            fontSize: "16px",
            color: "#333",
            "::placeholder": { color: "#999" }
        }
    }
});

card.mount("#card-element");

const form = document.getElementById("payment-form");

form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const button = e.target.querySelector(".pay-btn");
    button.disabled = true;
    button.innerText = "🔒 Processing Payment...";

    const emailInput = document.getElementById("email");
    const email = document.getElementById("email")?.value.trim() || "";

    if (!email) {
        document.getElementById("payment-result").innerText = "Email is required.";
        button.disabled = false;
        button.innerText = "Pay Securely";
        return;
    }

    try {
        const res = await fetch("/create-payment-intent", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ 
                email: email,
                tickets: "{{ tickets }}"
            })
        });

        const data = await res.json();

        const result = await stripe.confirmCardPayment(data.clientSecret, {
            payment_method: {
                card: card,
                billing_details: { email: email }
            }
        });

        if (result.error) {
            document.getElementById("payment-result").innerText = result.error.message;

            button.disabled = false;
            button.innerText = "Pay Securely";

        } else {

            const confirmRes = await fetch("/confirm-booking", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: new URLSearchParams({
                    email: email,
                    flightId: "{{ flightId }}",
                    tickets: "{{ tickets }}",
                    {% for i in 1..tickets %}
                    lastName{{ i }}: "{{ lastNames[i-1] }}",
                    passport{{ i }}: "{{ passportNumbers[i-1] }}",
                    {% endfor %}
                })
            });

            if (!confirmRes.ok) {
                const errorText = await confirmRes.text();
                document.getElementById("payment-result").innerText = errorText || "Booking failed.";
                button.disabled = false;
                button.innerText = "Pay Securely";
                return;
            }

            window.location.href = "/payment-success";
        }

    } catch (err) {
        document.getElementById("payment-result").innerText = "Something went wrong.";

        button.disabled = false;
        button.innerText = "Pay Securely";
    }
});
</script>

{% endblock %}
