{% extends "_layout/base.peb" %}

{% set headerRightText = 'Step 3 of 3: Checkout' %}

{% block content %}

<div class="wf-box-dashed">
  <div class="wf-row">
    <div class="wf-col" style="flex: 0 0 62%;">
      <div class="wf-box">
        <h2 class="wf-title">Passenger Information</h2>
        <div class="wf-rule"></div>

        <label for="first">First Name</label>
        <input id="first" type="text" placeholder="[Text Input]">

        <label for="last">Last Name</label>
        <input id="last" type="text" placeholder="[Text Input]">

        <label for="passport">Passport Number</label>
        <input id="passport" type="text" placeholder="[Text Input]">

        <label for="email">Email Address (Required for Guests)</label>
        <input id="email" type="email" placeholder="[Email Input]">

        <h3 class="wf-subtitle">Payment Details</h3>
        <div class="wf-rule"></div>

        <label for="card">Card Number</label>
        <input id="card" type="text" placeholder="XXXX-XXXX-XXXX-XXXX">
      </div>
    </div>

    <div class="wf-col" style="flex: 0 0 38%;">
      <div class="wf-box">
        <h3 class="wf-subtitle" style="margin-top: 0;">Review Booking</h3>
        <div class="wf-rule"></div>

        <div style="display:flex; justify-content: space-between; align-items: flex-start; gap: 10px;">
          <div>
            <div><strong>JFK to CDG</strong></div>
            <div style="color: var(--wf-muted);">Oct 12, 2026</div>
          </div>
          <button class="wf-btn" type="button">Edit</button>
        </div>

        <div class="wf-rule"></div>
        <div style="display:flex; justify-content: space-between;">
          <div>1x Economy Seat</div>
          <div>$499.00</div>
        </div>
        <div class="wf-rule" style="border-top-style: dashed;"></div>
        <div style="display:flex; justify-content: space-between;">
          <div>Taxes &amp; Fees</div>
          <div>$50.00</div>
        </div>
        <div class="wf-rule"></div>

        <div style="text-align:right; font-weight: 700; font-size: 18px;">Total: $549.00</div>

        <div style="margin-top: 16px;"></div>
        <button class="wf-btn wide" type="button">CHECKOUT</button>
      </div>
    </div>
  </div>
</div>

{% endblock %}
