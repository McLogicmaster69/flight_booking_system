{% extends "_layout/base.peb" %}

{% set activePage = 'checkout' %}
{% set inNav = true %}

{% set headerRightText = 'Step 3 of 3: Checkout' %}

{% block content %}

<h2>Flight</h2>

<h2>Selected Tickets: {{ tickets }}</h2>

<form action="/payment" method="post" onsubmit="return validateCheckoutForm()">

    <input type="hidden" name="token" value="{{ token }}">
    <input type="hidden" name="tickets" value="{{ tickets }}">

    {% for i in 1..tickets %}
        <h3>Passenger {{ i }}</h3>

        <input class="general-input" name="lastName{{ i }}" required placeholder="Last Name">
        <input class="general-input" name="passport{{ i }}" required placeholder="Passport Number">

        {% for flight in checkoutFlights %}

            <h4>{{ flight.info.startDestination }} → {{ flight.info.endDestination }}</h4>

            <select class="general-input" name="typeId{{ i }}_{{ flight.leg }}" required>
                <option value="">Select Ticket Type</option>
                {% for ticketType in ticketTypes %}
                    <option value="{{ ticketType.id }}">{{ ticketType.name }}</option>
                {% endfor %}
            </select>

            <select class="general-input class-select" name="classId{{ i }}_{{ flight.leg }}" data-passenger="{{ i }}" data-leg="{{ flight.leg }}" required>
                <option value="">Select Class</option>
                {% for flightClass in classes %}
                    <option value="{{ flightClass.id }}">{{ flightClass.name }}</option>
                {% endfor %}
            </select>

            <select class="general-input seat-select" name="seatId{{ i }}_{{ flight.leg }}" id="seatId{{ i }}_{{ flight.leg }}">
                <option value="">Select a class first</option>

                {% for seat in availableSeatsByFlight[flight.flightId] %}
                    <option value="{{ seat.id }}" data-class-id="{{ seat.classId }}" hidden disabled>
                        Seat {{ seat.number }} - £5
                    </option>
                {% endfor %}
            </select>
        {% endfor %}
    {% endfor %}

    {% if selectedRewards is not empty %}
        <div class="card">
            <h3>Selected Loyalty Rewards</h3>

            {% for reward in selectedRewards %}
                <p>
                    {{ reward.name }}
                    {% if reward.quantity > 1 %}
                        × {{ reward.quantity }}
                    {% endif %}
                </p>
            {% endfor %}
        </div>
    {% endif %}

    {% if upgradeCount > 0 %}
        <div class="card">
            <h3>Free Upgrade Assignment</h3>
            <p>Select which passenger ticket should receive each free upgrade.</p>

            {% for u in 1..upgradeCount %}
                <select class="general-input" name="upgradePassenger{{ u }}" required>
                    <option value="">Choose passenger for upgrade {{ u }}</option>
                    {% for i in 1..tickets %}
                        <option value="{{ i }}">Passenger {{ i }}</option>
                    {% endfor %}
                </select>
            {% endfor %}
        </div>
    {% endif %}

    <div style="display:none;">
        {% for reward in selectedRewards %}
            <input type="hidden" name="reward_{{ reward.key }}" value="{{ reward.quantity }}">
        {% endfor %}
    </div>

    <div id="checkout-error" style="color: red;"></div>
    <button type="submit">Proceed To Payment</button>

</form>

<script>
function validateCheckoutForm() {
    const error = document.getElementById("checkout-error");
    error.textContent = "";

    for (const select of document.querySelectorAll("select[required]")) {
        if (!select.value) {
            error.textContent = "Please select a ticket type and class for every flight.";
            select.focus();
            return false;
        }
    }

    return true;
}
</script>

<script>
document.querySelectorAll(".class-select").forEach(classSelect => {
    classSelect.addEventListener("change", function () {
        const passenger = this.getAttribute("data-passenger");
        const leg = this.getAttribute("data-leg");
        const selectedClassId = this.value;
        const seatSelect = document.getElementById("seatId" + passenger + "_" + leg);

        for (const option of seatSelect.options) {
            if (option.value === "") {
                option.textContent = selectedClassId
                    ? "Random seat - free"
                    : "Select a class first";
                option.hidden = false;
                option.disabled = false;
                continue;
            }

            const matchesClass = option.getAttribute("data-class-id") === selectedClassId;
            option.hidden = !matchesClass;
            option.disabled = !matchesClass;
        }

        seatSelect.value = "";
    });
});
</script>

<script>
const firstClassId = "1";

function getUpgradePassengers() {
    return Array.from(document.querySelectorAll('select[name^="upgradePassenger"]'))
        .map(select => select.value)
        .filter(value => value !== "");
}

function enforceUpgradeRules() {
    const upgradePassengers = getUpgradePassengers();

    document.querySelectorAll(".class-select").forEach(select => {
        const passenger = select.getAttribute("data-passenger");
        const firstClassOption = Array.from(select.options)
            .find(option => option.value === firstClassId);

        if (!firstClassOption) return;

        if (upgradePassengers.includes(passenger)) {
            firstClassOption.disabled = true;

            if (select.value === firstClassId) {
                select.value = "";
                select.dispatchEvent(new Event("change"));
            }
        } else {
            firstClassOption.disabled = false;
        }
    });
}

document.querySelectorAll('select[name^="upgradePassenger"]').forEach(select => {
    select.addEventListener("change", enforceUpgradeRules);
});

enforceUpgradeRules();
</script>

{% endblock %}
