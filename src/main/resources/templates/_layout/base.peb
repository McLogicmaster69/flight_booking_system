<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{% block title %}SkyBridge Airways{% endblock %}</title>

  <link rel="stylesheet" href="/static/css/custom.css">

  <script src="/static/js/htmx-1.9.12.min.js" defer></script>
  <script src="/static/js/app.js" defer></script>

  <script>
    (function () {
      try {
        var t = localStorage.getItem("a11y_text_size") || "default";
        var hc = localStorage.getItem("a11y_high_contrast") === "true";
        var rm = localStorage.getItem("a11y_reduce_motion") === "true";
        var ef = localStorage.getItem("a11y_enhanced_focus") === "true";
        var sh = localStorage.getItem("a11y_show_hints") === "true";

        document.addEventListener("DOMContentLoaded", function () {
          var b = document.body;
          if (!b) return;

          b.classList.add("text-size-" + t);
          if (hc) b.classList.add("high-contrast");
          if (rm) b.classList.add("reduce-motion");
          if (ef) b.classList.add("enhanced-focus");
          if (sh) b.classList.add("show-hints");

        });
      } catch (e) { }
    })();
  </script>
</head>

<body>

  <div id="status" role="status" aria-live="polite" aria-atomic="true"></div>

  {% if layout == "admin" %}

  <header class="site-header">
    <div class="header-top">

      <div class="brand">
        <span class="brand-mark"></span>
        <div>
          <a href="/">SkyBridge Airways</a>
          <small>Admin Portal</small>
        </div>
      </div>

      <nav class="top-links" aria-label="Admin">
        <a href="/" class="{% if activePage == 'live' %}is-active{% endif %}">View Live Site</a>
        <a href="/admin" class="{% if activePage == 'admin' %}is-active{% endif %}">Admin Dashboard</a>
        <a href="/login">Staff Logout</a>
      </nav>

    </div>
  </header>

  {% elseif inNav %}

  <header class="site-header">

    <div class="header-top">

      <div class="brand" aria-label="SkyBridge Airways">
        <span class="brand-mark" aria-hidden="true"></span>
        <div>
          SkyBridge Airways
          <small>Plan Travel · Manage Trips · Flight Status</small>
        </div>
      </div>

      <nav class="top-links" aria-label="Utility navigation">

        {% if (user.verifiedAccount == false) and logged_in %}
        <form method="post" action="/send-verification" style="display:inline;">
          <button type="submit" {% if activePage=='verify' %}is-active{% endif %}>
            Verify
          </button>
        </form>
        {% endif %}

        {% if logged_in %}
        <a href="/logout" class="{% if activePage == 'auth' %}is-active{% endif %}">Logout</a>
        {% else %}
        <a href="/login" class="{% if activePage == 'auth' %}is-active{% endif %}">Login</a>
        {% endif %}

        <span>{{ language | upper }}</span>

      </nav>

    </div>

    <nav aria-label="Primary" class="primary-nav">

      <a href="/" class="{% if activePage == 'home' %}is-active{% endif %}">Home</a>
      <a href="/book" class="{% if activePage == 'book' %}is-active{% endif %}">Book</a>
      <a href="/manage" class="{% if activePage == 'manage' %}is-active{% endif %}">Manage</a>
      <a href="/rewards" class="{% if activePage == 'rewards' %}is-active{% endif %}">Loyalty Rewards</a>
      <a href="/settings" class="{% if activePage == 'settings' %}is-active{% endif %}">Settings</a>
      <a href="/help" class="{% if activePage == 'help' %}is-active{% endif %}">Help</a>

    </nav>

  </header>

  {% else %}

  <header class="site-header">

    <div class="header-top">

      <div class="brand">
        <span class="brand-mark"></span>
        <div>
          <a href="/">SkyBridge Airways</a>
        </div>
      </div>

      <div class="header-right">
        {{ headerRightText }}
      </div>

    </div>

  </header>

  {% endif %}

  <div class="site-shell">

    <main id="main" tabindex="-1">
      {% block content %}
      {% endblock %}
    </main>

  </div>

  <footer>
    <small>© 2026 SkyBridge Airways.</small>
  </footer>

</body>

</html>